#!/usr/bin/env sh

ed ()
{
	file="$(fzf)"
	[[ ! -z "$file" ]] && vim "$file"
}

setup()
{
	set -xe
	rm -rf ~/Desktop ~/Templates ~/Music ~/Projects ~/Public
	ln -sf /mnt/5tb/Music $HOME/Music
	[[ ! -d "$HOME/VirtualBox VMs" ]] && ln -sf /mnt/1tb/Vbox_Vms "$HOME/VirtualBox VMs"
	[[ ! -d "$HOME/Programming" ]] && ln -sf /mnt/5tb/Programming $HOME/Programming
	[[ ! -d "$HOME/.config/mozilla" ]] && ln -sf /mnt/1tb/BrowserData/mozilla $HOME/.config
	[[ ! -d "$HOME/.config/chromium" ]] && ln -sf /mnt/1tb/BrowserData/chromium $HOME/.config
	set +xe
	curl -fLo ~/.vim/autoload/plug.vim --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim
}

install_pkgs()
{
	set -xe
	sudo pacman -Sy i3 i3status alacritty virtualbox virtualbox-host-dkms virtualbox-guest-iso \
		gvfs gvfs-smb gvfs-nfs thunar vim terminology rofi git ttf-liberation ttf-0xproto-nerd \
		noto-fonts noto-fonts-cjk noto-fonts-extra noto-fonts-emoji fzf bash-completion \
		clang playerctl openssh ttf-inconsolata xwallpaper picom dunst gnome-keyring exa man --noconfirm

	sudo pacman -S 86kbyte/ungoogled-chromium 86kbyte/yay-bin --noconfirm
	set +xe
}

