# Standard Aliases
alias \
	ls='exa --color=auto' \
	ll="ls -l" \
	lah="ls -lah" \
	grep='grep --color=auto' \
	nossvr="xset s off; xset s noblank; xset -dpms" \
	rm="rm -i" \
	pac="sudo pacman" \
	so="source" \
	cal="cal -m -3" \
	rld="source ~/.config/shell/aliasrc"

# Directory Shortcuts
alias \
	gvfsmnt="/run/user/1000/gvfs/" \
	8tb="/run/user/1000/gvfs/smb-share:server=10.0.0.1,share=8tb" \
	120g="/mnt/120g" \
	1tb="/mnt/1tb" \
	4tb="/mnt/4tb" \
	5tb="/mnt/5tb" \
	code="/mnt/5tb/code"
